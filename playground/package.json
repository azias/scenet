{
  "name": "scenet-playground",
  "version": "0.1.0",
  "private": true,
  "description": "Browser playground for Scenet, running the Python compiler under Pyodide.",
  "type": "module",
  "scripts": {
    "assets": "tsx scripts/fetch-assets.ts",
    "dev": "npm run assets && vite",
    "build": "npm run assets && tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "node --import tsx --test \"scripts/**/*.test.ts\" \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "monaco-editor": "0.54.0",
    "monaco-yaml": "^5.5.1",
    "pyodide": "^314.0.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "yaml": "^2.9.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "overrides": {
    "dompurify": "^3.4.14"
  }
}
